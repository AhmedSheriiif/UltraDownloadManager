<Window x:Class="UltraDownloadManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UltraDownloadManager.App.Converters"
        Title="Ultra Download Manager" Icon="Assets/app.ico"
        Style="{StaticResource AppWindow}"
        Width="1140" Height="660" MinWidth="820" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,8" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                        Click="AddDownload_Click" Content="➕  Add URL"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Margin="0,0,10,0"
                        Click="GrabVideo_Click" Content="🎬  Grab Video"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="⏸  Pause"
                        Command="{Binding PauseSelectedCommand}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="▶  Resume"
                        Command="{Binding ResumeSelectedCommand}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="🗑  Remove"
                        Command="{Binding RemoveSelectedCommand}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="📂  Open Folder"
                        Command="{Binding OpenContainingFolderCommand}"/>
                <Border DockPanel.Dock="Left" Width="1" Margin="6,2" Background="{StaticResource Brush.Border}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="⏸  Pause All"
                        Command="{Binding PauseAllCommand}"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="▶  Resume All"
                        Command="{Binding ResumeAllCommand}"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="⚙  Settings"
                        Click="Settings_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="🕘  History"
                        Click="History_Click"/>
            </DockPanel>
        </Border>

        <!-- Download queue -->
        <ListView Grid.Row="1" Margin="0" x:Name="DownloadsListView"
                  ItemsSource="{Binding Downloads}"
                  SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                  MouseDoubleClick="DownloadsListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Maximum="100" Width="330" HorizontalAlignment="Left"
                                                     Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Status" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                           FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Size" Width="150" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Speed" Width="90" DisplayMemberBinding="{Binding SpeedText}"/>
                    <GridViewColumn Header="ETA" Width="70" DisplayMemberBinding="{Binding EtaText}"/>
                    <GridViewColumn Header="Conn" Width="50" DisplayMemberBinding="{Binding ConnectionsText}"/>

                    <GridViewColumn Header="Actions" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Content="⏸" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Pause" Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.PauseSelectedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="▶" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Resume" Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ResumeSelectedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="📂" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Open containing folder"
                                            Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="🗑" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Remove / cancel"
                                            Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="▲" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Move up in queue" Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="▼" Padding="6,3" FontSize="11" Margin="0,0,2,0"
                                            ToolTip="Move down in queue" Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource ToolbarButton}" Content="⚡" Padding="6,3" FontSize="11"
                                            ToolTip="Set speed limit" Visibility="{Binding CanSetSpeedLimit, Converter={StaticResource BoolToVis}}"
                                            Click="SpeedLimit_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource Brush.TextSecondary}"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding GlobalDownloadSpeedText, StringFormat='↓ {0}'}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding ActiveCount, StringFormat='Active: {0}'}"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding QueuedCount, StringFormat='Queued: {0}'}"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
