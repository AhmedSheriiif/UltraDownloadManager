<Window x:Class="UltraDownloadManager.App.Views.AddVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grab Video" Height="560" Width="600"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Video or playlist URL (YouTube and hundreds of other sites):"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="UrlTextBox"/>
            <Button Grid.Column="1" x:Name="FetchButton" Style="{StaticResource FlatButton}" Content="Fetch Info" Margin="8,0,0,0" Padding="14,6"
                    Click="Fetch_Click"/>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Margin="0,14,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>

        <!-- Single video result -->
        <StackPanel Grid.Row="3" x:Name="InfoPanel" Margin="0,10,0,0" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="TitleTextBlock" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
            <TextBlock x:Name="MetaTextBlock" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Playlist result -->
        <DockPanel Grid.Row="3" x:Name="PlaylistPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="PlaylistSummaryTextBlock" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource FlatButton}" Content="Select All" Padding="10,4" Margin="0,0,8,0" Click="SelectAll_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="Select None" Padding="10,4" Click="SelectNone_Click"/>
            </StackPanel>
            <ListBox x:Name="PlaylistListBox" Background="{StaticResource Brush.Surface}" BorderThickness="1"
                     BorderBrush="{StaticResource Brush.Border}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Row="4" x:Name="OptionsPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Quality" Margin="0,0,0,6"/>
                <ComboBox x:Name="QualityComboBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                <CheckBox x:Name="SubtitlesCheckBox" Content="Download subtitles" Margin="0,0,0,8"/>
                <CheckBox x:Name="ThumbnailCheckBox" Content="Embed thumbnail as cover art"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Cancel" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource AccentButton}" Width="100"
                    IsEnabled="False" Click="Download_Click"/>
        </StackPanel>
    </Grid>
</Window>
