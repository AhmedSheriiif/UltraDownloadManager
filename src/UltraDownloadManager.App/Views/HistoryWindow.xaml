<Window x:Class="UltraDownloadManager.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download History" Width="820" Height="520"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" x:Name="HistoryListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding Category}"/>
                    <GridViewColumn Header="Source" Width="70" DisplayMemberBinding="{Binding SourceText}"/>
                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Completed" Width="150" DisplayMemberBinding="{Binding CompletedText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Clear History" Width="110" Margin="0,0,10,0" Click="ClearHistory_Click"/>
            <Button Content="Close" Width="90" Style="{StaticResource AccentButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
